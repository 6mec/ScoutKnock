# Copia este ficheiro para .env.local e preenche com as tuas chaves.
# O .env.local NUNCA vai para o Git e nunca se cola em conversas.
#
# Produção (Netlify): só estas sete. Tudo o resto fica de fora da Netlify, desligado.
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#   SITE_URL, COMPANY_SOURCE=osm, MARKETS_ENABLED=PT e, com o domínio, HOME_PORTFOLIO_SLUG
# Ver docs/publicar.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Modo pessoal: sem "true", ninguém cria conta e a raiz leva à entrada.
# Para fechar mesmo os registos, desliga também "Allow new users to sign up" no Supabase.
SIGNUPS_ENABLED=
# Países ligados. Vazio ou inválido fica só PT. PT,BR liga as cidades, os preços em reais e os textos do Brasil.
# A landing é gerada no build: mudar este valor obriga a publicar de novo.
MARKETS_ENABLED=PT

# Sem chave, o Radar usa dados de exemplo em dev e fica indisponível em produção.
# Com chave, os tetos e os custos são obrigatórios: sem eles o fornecedor não arranca.
GOOGLE_PLACES_API_KEY=
# Sem chave do Google: "osm" procura no OpenStreetMap (grátis, dados abertos, sem avaliações).
# Com a chave do Google, o Google passa à frente.
COMPANY_SOURCE=
# Tetos do projeto inteiro, em euros de custo estimado. A 0 bloqueiam tudo.
GOOGLE_DAILY_BUDGET_EUR=
GOOGLE_MONTHLY_BUDGET_EUR=
# Custo estimado de cada chamada, em euros. Confirmar na página de preços do Google.
GOOGLE_TEXT_SEARCH_COST_EUR=
GOOGLE_PLACE_DETAILS_COST_EUR=
# Opcional. Páginas de 20 resultados por busca, cada uma paga (1 por omissão, máximo 3).
GOOGLE_MAX_PAGES_PER_SEARCH=

# Verificação dos sites das empresas. Sem "true", teto e SITE_URL, não corre, e a busca segue igual.
SITE_CHECKS_ENABLED=
# Quem responde na página /bot. Sem os dois, a verificação não corre. Mudar obriga a publicar de novo.
BOT_CONTACT_NAME=
BOT_CONTACT_EMAIL=
# Máximo de sites verificados por dia, no projeto inteiro.
SITE_CHECKS_DAILY_LIMIT=
# Opcional. Sites por busca (8 por omissão, máximo 8).
SITE_CHECKS_PER_SEARCH=
# Opcional. Domínios que pediram exclusão, separados por vírgulas. Nunca são visitados.
SITE_CHECKS_EXCLUDED_HOSTS=

# Só modo de teste: uma chave real (sk_live_, rk_live_ ou pk_live_) desliga os pagamentos.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Preços criados no Stripe (price_...), por pack. Os _BRL só são precisos com BR em MARKETS_ENABLED.
STRIPE_PRICE_STARTER_EUR=
STRIPE_PRICE_STARTER_BRL=
STRIPE_PRICE_PRO_EUR=
STRIPE_PRICE_PRO_BRL=
STRIPE_PRICE_AGENCY_EUR=
STRIPE_PRICE_AGENCY_BRL=
# Opcional: pack anual, só em euros (preço por ano criado no Stripe). O separador
# "Anual" só aparece com os três e com YEARLY_PRICES_EUR decidido em src/lib/account/rules.ts.
STRIPE_PRICE_STARTER_EUR_YEARLY=
STRIPE_PRICE_PRO_EUR_YEARLY=
STRIPE_PRICE_AGENCY_EUR_YEARLY=

# Publicar como oficial, a 5 €/mês. Sem o preço ou o contacto de remoção, só a publicação fica desligada.
STRIPE_PRICE_OFFICIAL_SITE_EUR=
# Email do link "Pedir remoção deste site", no rodapé dos sites oficiais.
OFFICIAL_SITE_REMOVAL_CONTACT=
# Modelo de subdomínio. Vazio: os sites ficam em /s/nome. Precisa de domínio com DNS curinga.
OFFICIAL_SITES_BASE_DOMAIN=

# Sem esta chave, as mensagens são texto de modelo com a etiqueta "Exemplo".
ANTHROPIC_API_KEY=

RESEND_API_KEY=
# Só "true" envia a destinatários reais, e precisa de domínio verificado no Resend.
# Desligado, tudo vai para o endereço de teste do Resend e, em produção, a lista de espera fica fechada.
EMAIL_REAL_SENDING=

# Endereço público do site, sem barra no fim (por exemplo https://nome.netlify.app).
# Serve para os links do portfólio, a pré-visualização ao partilhar e a lista de espera.
# Com um domínio próprio em https, o www e o endereço .netlify.app de produção passam a
# reencaminhar para ele (as pré-visualizações da Netlify e o localhost não).
SITE_URL=
# Endereço (slug) do portfólio que abre na raiz do domínio; /p/<slug> passa a levar à raiz.
# Vazio: a raiz leva à entrada.
HOME_PORTFOLIO_SLUG=

# Lista de espera (desligada em produção)
WAITLIST_EMAIL_FROM=
WAITLIST_TOKEN_SECRET=
